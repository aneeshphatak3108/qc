# Python
venv/
venv-qiskit/
__pycache__/
*.pyc

# Run outputs: keep only the benchmark results (results.json + logs),
# everything else is regenerated by main.py / benchmark.py / run_tests.sh
outputs/*
!outputs/benchmark/
outputs/benchmark/**/*.png
!outputs/feature_maps/
outputs/feature_maps/*/*/*.png
!outputs/hardware/
outputs/hardware/dryrun*/kernels.npz

# LaTeX build files (report.pdf itself is kept)
report/*.aux
report/*.log
report/*.out
report/*.toc
